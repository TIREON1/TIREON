<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 기록 중 알림을 표시하려면 Android 13부터 사용자 승인이 필요하다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TIREON">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TIREON">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="ai.tireon.app.practice.PracticeActivity"
            android:exported="false"
            android:theme="@style/Theme.TIREON">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!-- 주행 세션은 DO를 선언하지 않는다. 주행 중 플랫폼이 자동으로 가린다. -->
        <activity
            android:name="ai.tireon.app.driving.DrivingSessionActivity"
            android:exported="false"
            android:theme="@style/Theme.TIREON" />
        <!-- 주행 기록 중 내비게이션으로 넘어가도 프로세스가 얼지 않게 한다. 위치·미디어 등 정해진 유형에 해당하지 않아 specialUse를 쓴다. -->
        <service
            android:name="ai.tireon.app.driving.DrivingRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="주행 중 차량 신호(속도·페달·조향)를 기록해 운전 습관 리포트를 만든다" />
        </service>
    </application>

</manifest>
