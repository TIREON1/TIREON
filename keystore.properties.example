# Release 서명 설정 예시
# 이 파일을 keystore.properties로 복사한 뒤 실제 값으로 채우세요.
# keystore.properties는 .gitignore에 의해 커밋되지 않습니다.
#
# 비밀번호는 `openssl rand -hex 24`로 생성한 값을 권장합니다.
# PKCS12 키스토어는 storePassword와 keyPassword를 동일하게 사용합니다.
storeFile=/absolute/path/to/tireon-release.jks
storePassword=CHANGE_ME
keyAlias=tireon
keyPassword=CHANGE_ME
